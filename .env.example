# Copy to `.env` (git-ignored) and fill in ONE of these to run the live
# exception-triage tier. Without either, the pipeline still runs end to end and
# the report states that triage was SIMULATED.
#
# Gemini has a free tier and needs no credit card: https://aistudio.google.com
GEMINI_API_KEY=

# Optional: override the model if your key exposes a different one.
# GEMINI_MODEL=gemini-2.5-flash

# Alternative provider. Paid, from https://console.anthropic.com
# ANTHROPIC_API_KEY=
